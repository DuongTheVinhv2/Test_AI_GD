{
  "name": "sandloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sand Loop - a conveyor sand-sorting puzzle built with three.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "designer": "tsc --noEmit && vite build --config vite.designer.config.ts",
    "designer:dev": "vite --config vite.designer.config.ts --host 127.0.0.1 --port 5174 --open /designer.html",
    "analytics": "tsc --noEmit && vite build --config vite.analytics.config.ts",
    "analytics:dev": "vite --config vite.analytics.config.ts --host 127.0.0.1 --port 5175 --open /analytics.html"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "exceljs": "^4.4.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
